{
  "name": "cat-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Multi-Livestock Marketplace monorepo (frontend, admin, backend)",
  "workspaces": [
    "frontend",
    "admin",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@cat-marketplace/backend",
    "dev:frontend": "npm run dev --workspace=@cat-marketplace/frontend",
    "dev:admin": "npm run dev --workspace=@cat-marketplace/admin",
    "build:backend": "npm run build --workspace=@cat-marketplace/backend",
    "build:frontend": "npm run build --workspace=@cat-marketplace/frontend",
    "build:admin": "npm run build --workspace=@cat-marketplace/admin",
    "build": "npm run build:backend",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:admin",
    "start": "node backend/dist/server.js",
    "start:backend": "npm run start --workspace=@cat-marketplace/backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@cat-marketplace/backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d mongo api",
    "docker:up:full": "docker compose -f docker/docker-compose.yml --profile full up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f api",
    "prepare": "node -e \"try{require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}

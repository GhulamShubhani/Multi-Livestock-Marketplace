{
  "name": "cat-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Cat Marketplace monorepo (frontend, admin, backend)",
  "workspaces": [
    "frontend",
    "admin",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:admin": "npm run dev --workspace=admin",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:admin": "npm run build --workspace=admin",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "node -e \"try{require('husky')}catch(e){process.exit(0)}\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}

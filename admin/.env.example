# Explicit URL wins (set this on Vercel admin deploy)
# VITE_API_URL=https://multi-livestock-marketplace.onrender.com/api/v1

# MODE: local | remote | production | prod
#   local → VITE_API_LOCAL_URL
#   remote|production|prod → VITE_API_REMOTE_URL
VITE_API_MODE=local
VITE_API_LOCAL_URL=http://localhost:5000/api/v1
VITE_API_REMOTE_URL=https://multi-livestock-marketplace.onrender.com/api/v1
VITE_APP_NAME=Multi-Livestock Marketplace CRM

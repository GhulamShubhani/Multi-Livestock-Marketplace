# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cat_marketplace
# Use mongodb+srv://... for Atlas. If Windows antivirus breaks TLS, set:
# MONGODB_TLS_ALLOW_INVALID_CERTS=true

# CORS (comma-separated origins)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# JWT (Phase 2 — placeholders required for env schema)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Body size
BODY_LIMIT=100kb

# Logging
LOG_LEVEL=info

# Default currency (ISO 4217)
DEFAULT_CURRENCY=USD

# Super admin seed
SUPER_ADMIN_EMAIL=superadmin@catmarketplace.local
SUPER_ADMIN_PASSWORD=SuperAdmin!23456
SEED_ON_BOOT=true

# Cloudinary (optional in development — mock uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cat-marketplace
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=10

# Stripe (optional in development — mock checkout if empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
TAX_RATE_BPS=0
SHIPPING_FLAT_CENTS=0

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/livestock_marketplace
# Use mongodb+srv://... for Atlas. If Windows antivirus breaks TLS, set:
# MONGODB_TLS_ALLOW_INVALID_CERTS=true

# CORS — comma-separated origins (local + deployed)
FRONTEND_URL=http://localhost:3005,https://cat-shop-frontend-sand.vercel.app
ADMIN_URL=http://localhost:5173,https://cat-shop-admin-rho.vercel.app

# On Vercel API (cross-site cookies from localhost / other domains):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# SEED_ON_BOOT=false

# JWT (Phase 2 — placeholders required for env schema)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Body size
BODY_LIMIT=100kb

# Logging
LOG_LEVEL=info

# Default currency (ISO 4217)
DEFAULT_CURRENCY=INR

# Super admin seed
SUPER_ADMIN_EMAIL=superadmin@livestockmarketplace.local
SUPER_ADMIN_PASSWORD=SuperAdmin!23456
SEED_ON_BOOT=true

# Cloudinary (optional in development — mock uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=livestock-marketplace
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=10

# Tax / shipping (minor units, e.g. paise)
TAX_RATE_BPS=0
SHIPPING_FLAT_CENTS=0

# SMTP (Gmail: use an App Password, not your normal Gmail password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM="Livestock Marketplace <your-gmail@gmail.com>"
# Set true if Windows antivirus causes "self-signed certificate in certificate chain"
SMTP_TLS_ALLOW_INVALID_CERTS=true

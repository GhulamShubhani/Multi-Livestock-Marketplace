# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cat_marketplace

# CORS (comma-separated origins)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# JWT (Phase 2 — placeholders required for env schema)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Body size
BODY_LIMIT=100kb

# Logging
LOG_LEVEL=info

# Default currency (ISO 4217)
DEFAULT_CURRENCY=USD
